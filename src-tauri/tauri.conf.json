{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCU Config Tool",
  "version": "1.0.0",
  "identifier": "com.vcu.configtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VCU 可视化配置平台",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
